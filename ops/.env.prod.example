# Production env — copy to /srv/tpx/.env on the VPS (chmod 600, root only).
# Injected wholesale into the backend container via compose `env_file:`, and
# read by compose for ${...} interpolation. NEVER commit the real file.
#
# ⚠ compose >= 2.24 INTERPOLATES the values in this file: a `$` inside a
# password must be written `$$` (a lone `$x` silently truncates the value —
# the backend then refuses to boot, by design).
# IMAGE_TAG is appended/updated by the deploy pipeline (last known-good
# backend image) — never set it by hand.

# --- GHCR image owner (your GitHub username/org, lowercase) ---
GHCR_OWNER=your-github-user

# --- OKX region: 'global' (default) or 'eea' for EU accounts (registered on my.okx.com) ---
# EU accounts are rejected on the global hosts (50119/60032) — set 'eea'.
OKX_REGION=global

# --- Public domain (A/AAAA record must point at this VPS) + ACME contact ---
DOMAIN=trader.example.com
ACME_EMAIL=you@example.com

# --- Postgres (compose builds DATABASE_URL from these; pick a strong password) ---
POSTGRES_USER=tpx
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=tpx

# --- App secrets ---
# UI/API password — MUST be set in prod (empty = auth OFF). Strong, unique.
ADMIN_PASSWORD=change-me-strong
# 64 hex chars (32 bytes). Encrypts OKX API keys at rest. GENERATE ONCE & BACK UP
# (losing it = stored OKX keys become undecryptable):
#   bun -e "console.log(crypto.randomBytes(32).toString('hex'))"
MASTER_KEY=

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOTE: OKX API key + secret + passphrase are NOT set here — you enter them in
# the UI (Settings), encrypted into Postgres with MASTER_KEY. PORT is fixed to
# 3001 by the compose base; DATABASE_URL is derived from POSTGRES_* above.
