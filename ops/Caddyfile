{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# mTLS — only devices holding the client certificate can reach the app.
	# Anyone else (with the domain/IP) is rejected at the TLS handshake and
	# never sees the app. The client cert IS the credential (no password).
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/ca.crt
			}
		}
	}

	# Security headers (defense-in-depth)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}

	# API + WebSocket → backend. Handled FIRST so the SPA try_files below never
	# rewrites these paths. reverse_proxy upgrades WebSockets automatically.
	@backend path /api/* /ws /ws/*
	handle @backend {
		reverse_proxy backend:3001
	}

	# Everything else → static SPA (deployed via `make deploy-web`), with
	# client-side routing fallback to index.html.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
