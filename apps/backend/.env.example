# Environment for the backend app. Copy to `.env` (gitignored) and fill in.
# Also read by the DB migration tooling (packages/db → drizzle-kit) for DATABASE_URL.
#
# --- Database ---
# POSTGRES_PORT is the host port mapped by ops/docker-compose.yml (pick a free one)
POSTGRES_PORT=5436
DATABASE_URL=postgres://tpx:tpx@localhost:5436/tpx

# --- Server ---
PORT=3001
# Password protecting the UI/API. Leave empty to disable auth (local dev only!).
ADMIN_PASSWORD=
# 64 hex chars (32 bytes) used to encrypt Binance API keys at rest.
# Generate one with:  bun -e "console.log(crypto.randomBytes(32).toString('hex'))"
MASTER_KEY=

# --- Market data storage (aggTrades binary files, downloads, artifacts) ---
DATA_DIR=./data

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
